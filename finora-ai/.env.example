# =====================================================================
# finora-ai — biến môi trường chạy local
#
# Cách dùng: copy thành finora-ai/.env rồi điền giá trị (.env bị Git ignore).
# main.py tự nạp file này lúc khởi động; biến đã có sẵn trong môi trường
# thì giữ nguyên, không bị ghi đè.
# =====================================================================

# <<< PHẢI ĐIỀN >>> Lấy tại https://aistudio.google.com/apikey
# OCR CCCD chạy hoàn toàn bằng Gemini — thiếu key thì endpoint eKYC trả lỗi.
# LƯU Ý: ảnh CCCD (PII) sẽ được gửi tới API của Google.
GEMINI_API_KEY=

# Model đọc ảnh, mặc định gemini-2.5-flash
# GEMINI_OCR_MODEL=gemini-2.5-flash
