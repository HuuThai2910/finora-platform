# =====================================================================
# finora-ai — biến môi trường chạy local
#
# Cách dùng: copy thành finora-ai/.env rồi điền giá trị (.env bị Git ignore).
# main.py tự nạp file này lúc khởi động; biến đã có sẵn trong môi trường
# thì giữ nguyên, không bị ghi đè.
# =====================================================================

# <<< PHẢI ĐIỀN nếu muốn OCR bằng Gemini >>> Lấy tại https://aistudio.google.com/apikey
# Thiếu key thì OCR CCCD tự rơi về EasyOCR chạy offline (chậm và kém bền hơn).
# LƯU Ý: ảnh CCCD (PII) sẽ được gửi tới API của Google khi bật Gemini.
GEMINI_API_KEY=

# Model đọc ảnh, mặc định gemini-2.5-flash
# GEMINI_OCR_MODEL=gemini-2.5-flash

# Thư mục lưu ảnh OCR nhận được, phục vụ debug local. Ảnh là PII — chỉ bật
# khi cần chẩn đoán rồi tắt và xoá thư mục.
# EKYC_DEBUG_DIR=
