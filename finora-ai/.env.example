# =====================================================================
# finora-ai — biến môi trường chạy local
#
# Cách dùng: copy thành finora-ai/.env rồi điền giá trị (.env bị Git ignore).
# main.py tự nạp file này lúc khởi động; biến đã có sẵn trong môi trường
# thì giữ nguyên, không bị ghi đè.
# =====================================================================

# <<< PHẢI ĐIỀN >>> Lấy tại https://aistudio.google.com/apikey
# OCR CCCD chạy hoàn toàn bằng Gemini — thiếu key thì endpoint eKYC trả lỗi.
# LƯU Ý: ảnh CCCD (PII) sẽ được gửi tới API của Google.
GEMINI_API_KEY=

# Model đọc ảnh, mặc định gemini-2.5-flash
# GEMINI_OCR_MODEL=gemini-2.5-flash

# ── Tra CCCD qua finora-user để chấm điểm CIC ────────────────────────────────
# Loan Service không được giữ CCCD (xem BorrowerProfileResult), nên khi hồ sơ chỉ
# có borrower_id thì AI tự hỏi finora-user. Thiếu KEYCLOAK_CLIENT_SECRET thì bước
# này bị bỏ qua và hồ sơ bị chấm như người chưa có lịch sử tín dụng.
USER_SERVICE_URL=http://localhost:8085
KEYCLOAK_TOKEN_URL=http://localhost:8180/realms/finora/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=finora-user-client
KEYCLOAK_CLIENT_SECRET=<<< PHẢI ĐIỀN — trùng giá trị trong docker/.env >>>
