# =====================================================================
# finora-ai — biến môi trường chạy local
#
# Cách dùng: copy thành finora-ai/.env rồi điền giá trị (.env bị Git ignore).
# main.py tự nạp file này lúc khởi động; biến đã có sẵn trong môi trường
# thì giữ nguyên, không bị ghi đè.
# =====================================================================

# ── eKYC: bảo vệ endpoint nội bộ ─────────────────────────────────────────────
# /api/v1/ai/ekyc/* chỉ nhận access token service account finora-user-client (client role ai:ekyc:ocr,
# D34/D35); cấu hình kiểm token ở khối "Xác thực request tới AI" cuối file. Gateway cũng chặn
# /api/v1/ai/ekyc/** từ ngoài.

# ── eKYC: Gemini chỉ điền chỗ trống ──────────────────────────────────────────
# Đọc CCCD dựa trước hết vào nguồn tất định (QR, MRZ có check digit). Gemini chỉ được
# hỏi phần còn thiếu, chỉ nhận crop đã che ảnh chân dung (không bao giờ gửi khuôn mặt)
# hoặc riêng dải MRZ. Không có key thì pipeline vẫn chạy, thiếu trường thì đi duyệt tay.
#
# QUYỀN RIÊNG TƯ: điều khoản gói MIỄN PHÍ của Gemini API cấm gửi dữ liệu cá nhân
# ("Do not submit sensitive, confidential, or personal information to the Unpaid
# Services"). Chỉ dùng key gói TRẢ PHÍ, hoặc khi demo chỉ dùng thẻ mẫu / thẻ của người
# đã đồng ý bằng văn bản. Muốn chắc chắn không gửi gì ra ngoài: EKYC_GEMINI_MODE=off.
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini, mặc định gemini-2.5-flash (bị giới hạn với project mới). Project mới nên
# chọn model mà trang https://ai.google.dev/gemini-api/docs/deprecations khuyên dùng.
# GEMINI_OCR_MODEL=gemini-2.5-flash

# off | fallback (mặc định fallback khi có key). off = không bao giờ gọi Gemini.
# EKYC_GEMINI_MODE=fallback
# Thời gian chờ tối đa mỗi lần gọi Gemini (ms); quá giờ/429/lỗi đều coi như không có AI.
# EKYC_GEMINI_TIMEOUT_MS=15000

# ── eKYC: cờ nghiệp vụ đọc thẻ ───────────────────────────────────────────────
# Thu thêm quê quán / nơi đăng ký khai sinh (chỉ AI đọc được). Mặc định false theo
# nguyên tắc giảm thiểu dữ liệu — P2P không cần hai trường này.
# EKYC_OPTIONAL_FIELDS=false
# true = cho AUTO_OK khi chỉ có MỘT nguồn tất định (QR hoặc MRZ) + một nguồn đọc độc
# lập (OCR/AI) khớp số, ngày sinh, giới tính. Mặc định false: phải có cả QR và MRZ.
# EKYC_ALLOW_SINGLE_DETERMINISTIC=false
# Số lần yêu cầu chụp lại trước khi chuyển lỗi dữ liệu sang duyệt tay (chân dung hỏng
# và "không có số định danh" vẫn luôn bắt chụp lại).
# EKYC_MAX_RETAKES=2

# ── eKYC: Tesseract và model khuôn mặt ───────────────────────────────────────
# Đường dẫn tesseract nếu không nằm trong PATH (Docker đã cài sẵn; Windows thường chưa
# có → MRZ chuyển sang Gemini nếu bật, không thì hồ sơ đi duyệt tay).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# EKYC_TESSERACT_TIMEOUT_S=10
# Thư mục chứa face_detection_yunet_2023mar.onnx + face_recognition_sface_2021dec.onnx.
# Mặc định finora-ai/models/face — tải bằng: python scripts/download_face_models.py
# Thiếu model thì /document và /liveness trả 503 FACE_MODELS_MISSING.
# EKYC_FACE_MODEL_DIR=

# ── eKYC: ngưỡng đọc thẻ (placeholder, hiệu chỉnh bằng scripts/ekyc_eval_cccd.py) ──
# Đổi bất kỳ ngưỡng nào mà không đặt tên phiên bản thì thresholds_version tự gắn đuôi
# "+env-<hash>" để kết quả lưu lại biết được chấm bằng bộ ngưỡng nào.
# EKYC_DOC_THRESHOLDS_VERSION=doc-2026-10-placeholder
# Contour thẻ phải chiếm ít nhất tỉ lệ này của ảnh.
# EKYC_CARD_MIN_AREA_RATIO=0.20
# Chiều rộng thẻ sau khi nắn (px) và chiều rộng đo chất lượng (px).
# EKYC_CARD_WARP_WIDTH=1400
# EKYC_QUALITY_WIDTH=1000
# Độ nét (phương sai Laplacian), tỉ lệ pixel loá tối đa, độ sáng tối thiểu (0..1).
# EKYC_QUALITY_MIN_SHARPNESS=100
# EKYC_QUALITY_MAX_GLARE=0.02
# EKYC_QUALITY_MIN_BRIGHTNESS=0.25
# Chân dung trên thẻ: điểm YuNet, khoảng cách hai mắt (px), độ nét, phần trái chứa ảnh.
# EKYC_PORTRAIT_MIN_SCORE=0.6
# EKYC_PORTRAIT_MIN_IED=40
# EKYC_PORTRAIT_MIN_SHARPNESS=40
# EKYC_PORTRAIT_REGION_RATIO=0.45
# Số ký tự được lệch khi tìm số định danh in ở mặt trước (gắn hai mặt thẻ).
# EKYC_FRONT_ID_MAX_MISMATCH=1

# ── eKYC: ngưỡng liveness (placeholder, hiệu chỉnh bằng scripts/ekyc_calibrate.py) ──
# EKYC_LIVENESS_THRESHOLDS_VERSION=liveness-2026-10-placeholder
# Ngưỡng lệch tỉ số quay đầu (r) và ngẩng/cúi (p) so với mức nền chính diện.
# EKYC_LIVENESS_THETA_R=0.25
# EKYC_LIVENESS_THETA_P=0.15
# Cosine nhỏ nhất giữa các khung chính diện (cùng một người).
# EKYC_LIVENESS_T_SAME=0.5
# So mặt với chân dung thẻ: >= T_HIGH khớp, < T_LOW không khớp, ở giữa → duyệt tay.
# EKYC_FACE_MATCH_T_HIGH=0.50
# EKYC_FACE_MATCH_T_LOW=0.25
# IED tối thiểu của mặt trong video (px, toạ độ gốc), tỉ lệ khung đúng 1 mặt, tỉ lệ khung
# có mặt tối thiểu để phân tích, tỉ lệ khung nhiều mặt tối đa.
# EKYC_LIVENESS_MIN_IED=40
# EKYC_LIVENESS_MIN_SINGLE_FACE_RATIO=0.9
# EKYC_LIVENESS_NO_FACE_RATIO=0.5
# EKYC_LIVENESS_MAX_MULTI_FACE_RATIO=0.05
# Độ sáng tối thiểu vùng mặt (0..1), độ nét tối thiểu khung chính diện tốt nhất.
# EKYC_LIVENESS_MIN_BRIGHTNESS=0.25
# EKYC_LIVENESS_MIN_SHARPNESS=30
# fps tối thiểu, khoảng hở PTS tối đa (ms).
# EKYC_LIVENESS_MIN_FPS=10
# EKYC_LIVENESS_MAX_GAP_MS=250
# Thời lượng hợp lệ: [tổng hold − MIN_SLACK, ceil(tổng hold) + MAX_SLACK + 0,5 s] (ms).
# EKYC_LIVENESS_DURATION_MIN_SLACK_MS=1000
# EKYC_LIVENESS_DURATION_MAX_SLACK_MS=3000
# Sai số khoảng cách giữa hai đỉnh động tác: max(TOL_S giây, TOL_RATIO × khoảng kỳ vọng).
# EKYC_INTERVAL_TOL_S=0.7
# EKYC_INTERVAL_TOL_RATIO=0.35
# Tần số lấy mẫu khung, chiều rộng khung đưa vào YuNet, điểm YuNet tối thiểu.
# EKYC_LIVENESS_SAMPLE_FPS=10
# EKYC_LIVENESS_DETECT_WIDTH=480
# EKYC_LIVENESS_MIN_FACE_SCORE=0.8
# Số khung chính diện dùng kiểm cùng người.
# EKYC_LIVENESS_IDENTITY_FRAMES=6
# Đảo chiều quay trái/phải khi video bị lật gương. Đặt riêng theo nền tảng (spec.platform
# do app gửi) vì camera trước iOS và Android có thể lật khác nhau; không đặt riêng thì
# dùng giá trị chung. Kiểm chiều bằng: python scripts/ekyc_calibrate.py ... (in dấu r
# theo từng nền tảng).
# EKYC_LIVENESS_YAW_INVERT=false
# EKYC_LIVENESS_YAW_INVERT_IOS=
# EKYC_LIVENESS_YAW_INVERT_ANDROID=

# ── CIC Service (bản Node đã deploy Vercel) ──────────────────────────────────
# Chạy cic-service local thì đổi thành http://localhost:9000. Gọi lỗi hoặc quá
# CIC_TIMEOUT_SECONDS (mặc định 3 giây) thì hồ sơ bị chấm như chưa có dữ liệu CIC.
CIC_SERVICE_URL=https://cic-service-node.vercel.app
# CIC_TIMEOUT_SECONDS=3.0

# ── Tra CCCD qua finora-user để chấm điểm CIC ────────────────────────────────
# Loan Service không được giữ CCCD (xem BorrowerProfileResult), nên khi hồ sơ chỉ
# có borrower_id thì AI tự hỏi finora-user. Thiếu KEYCLOAK_CLIENT_SECRET thì bước
# này bị bỏ qua và hồ sơ bị chấm như người chưa có lịch sử tín dụng.
USER_SERVICE_URL=http://localhost:8085
KEYCLOAK_TOKEN_URL=http://localhost:8180/realms/finora/protocol/openid-connect/token
# Client riêng của AI (D34), chỉ có user:admin:read_all. docker/keycloak/add-service-clients.sh tạo client và ghi
# secret vào docker/.env (KEYCLOAK_AI_CLIENT_SECRET); chạy AI ngoài Docker thì chép giá trị đó vào đây.
KEYCLOAK_CLIENT_ID=finora-ai-client
KEYCLOAK_CLIENT_SECRET=<<< PHẢI ĐIỀN — trùng KEYCLOAK_AI_CLIENT_SECRET trong docker/.env >>>

# ── Xác thực request tới AI (D35) ────────────────────────────────────────────
# Mọi endpoint trừ /health cần access token Keycloak. Issuer cố định localhost:8180 (KC_HOSTNAME_URL); trong Docker
# JWKS đọc qua http://keycloak:8080/realms/finora/protocol/openid-connect/certs.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/finora
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/finora/protocol/openid-connect/certs
# local/e2e/demo mở Swagger (/docs); staging/production tắt.
FINORA_ENVIRONMENT=local
