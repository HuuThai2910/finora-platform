# =====================================================================
# finora-ai — biến môi trường chạy local
#
# Cách dùng: copy thành finora-ai/.env rồi điền giá trị (.env bị Git ignore).
# main.py tự nạp file này lúc khởi động; biến đã có sẵn trong môi trường
# thì giữ nguyên, không bị ghi đè.
# =====================================================================

# <<< PHẢI ĐIỀN >>> Lấy tại https://aistudio.google.com/apikey
# OCR CCCD chạy hoàn toàn bằng Gemini — thiếu key thì endpoint eKYC trả lỗi.
# LƯU Ý: ảnh CCCD (PII) sẽ được gửi tới API của Google.
GEMINI_API_KEY=

# Model đọc ảnh, mặc định gemini-2.5-flash
# GEMINI_OCR_MODEL=gemini-2.5-flash

# ── CIC Service (bản Node đã deploy Vercel) ──────────────────────────────────
# Chạy cic-service local thì đổi thành http://localhost:9000. Gọi lỗi hoặc quá
# CIC_TIMEOUT_SECONDS (mặc định 3 giây) thì hồ sơ bị chấm như chưa có dữ liệu CIC.
CIC_SERVICE_URL=https://cic-service-node.vercel.app
# CIC_TIMEOUT_SECONDS=3.0

# ── Tra CCCD qua finora-user để chấm điểm CIC ────────────────────────────────
# Loan Service không được giữ CCCD (xem BorrowerProfileResult), nên khi hồ sơ chỉ
# có borrower_id thì AI tự hỏi finora-user. Thiếu KEYCLOAK_CLIENT_SECRET thì bước
# này bị bỏ qua và hồ sơ bị chấm như người chưa có lịch sử tín dụng.
USER_SERVICE_URL=http://localhost:8085
KEYCLOAK_TOKEN_URL=http://localhost:8180/realms/finora/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=finora-user-client
KEYCLOAK_CLIENT_SECRET=<<< PHẢI ĐIỀN — trùng giá trị trong docker/.env >>>

# ── Xác thực người gọi (JWT Keycloak) ────────────────────────────────────────
# finora-ai tự kiểm access token như các service Java. Chạy uvicorn trên máy thì giữ
# localhost; trong docker compose hai biến này được ghi đè bằng tên nội bộ `keycloak`.
KEYCLOAK_JWKS_URL=http://localhost:8180/realms/finora/protocol/openid-connect/certs
# Danh sách issuer chấp nhận, phân tách dấu phẩy. Local, docker và Azure đều là giá trị dưới
# vì Keycloak cố định KC_HOSTNAME_URL=http://localhost:8180.
KEYCLOAK_ISSUERS=http://localhost:8180/realms/finora

# ── Mã nội bộ cho Loan gọi /credit/explain ──────────────────────────────────
# PHẢI trùng AI_INTERNAL_TOKEN trong finora-loan/.env. Để trống thì mọi lần Loan chấm điểm
# bị từ chối 401 (đóng mặc định, vì /explain mở ra Internet qua gateway).
#   Sinh nhanh:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_INTERNAL_TOKEN=

# ── Trợ lý FINORA (AI-CHAT-001) ──────────────────────────────────────────────
# Mặc định TẮT. Bật thì câu hỏi và dữ kiện đã lược định danh được gửi tới nhà cung cấp LLM ở
# nước ngoài. Tắt thì /api/v1/ai/assistant/* trả 503 ASSISTANT_DISABLED và app ẩn nút chat.
ASSISTANT_ENABLED=false
# Vai trò được dùng trợ lý, phân tách dấu phẩy: BORROWER, INVESTOR, ADMIN. Bỏ trống = cả ba.
ASSISTANT_TOOLSETS=BORROWER,INVESTOR,ADMIN
# Thứ tự thử nhà cung cấp cho mọi câu (spec mục 7.1; Task 1 chưa đo được nhà nào nên giữ thứ tự này).
# Nhà thiếu khóa API tự bị bỏ qua. Thêm ollama_local khi chạy model trên máy dev.
# Mọi nhà trong danh sách này đều được nhận dữ liệu cá nhân (làn USER_DATA) nếu id của nó khai làn đó.
ASSISTANT_PROVIDERS=cloudflare_gemma26b,groq_gptoss120b,groq_qwen27b,groq_gptoss20b,openrouter_gemma31b
# Nhà CHỈ được nhận câu không có dữ liệu cá nhân (làn PUBLIC: kiến thức chung, KPI tổng hợp).
# Gemini bản miễn phí dùng dữ liệu để huấn luyện: tuyệt đối không đưa vào ASSISTANT_PROVIDERS
# (router vẫn tự loại nó khỏi làn USER_DATA, nhưng đừng dựa vào lớp chặn cuối).
ASSISTANT_PUBLIC_PROVIDERS=gemini_gemma31b
# Muối băm user id trong log trợ lý. Đặt một chuỗi ngẫu nhiên cố định; bỏ trống thì mỗi lần khởi
# động sinh muối mới (log không nối được qua các lần restart).
#   Sinh nhanh:  python -c "import secrets; print(secrets.token_hex(16))"
ASSISTANT_HASH_SALT=
# Đổi model của một nhà mà không sửa code: ASSISTANT_MODEL_<ID viết hoa>=<model>.
# CẢNH BÁO: đổi model KHÔNG đổi làn dữ liệu — model mới vẫn nhận dữ liệu cá nhân nếu id gốc thuộc
# làn USER_DATA. Chỉ chọn model/endpoint KHÔNG dùng dữ liệu để huấn luyện; với OpenRouter phải tắt
# "Model Training"/bật lọc dữ liệu ở Settings → Privacy, nếu không request :free có thể bị định tuyến
# tới endpoint giữ dữ liệu.
# ASSISTANT_MODEL_OLLAMA_LOCAL=gemma4:e4b

# Khóa API nhà cung cấp LLM (gói miễn phí, mỗi nhà một tài khoản). Chỉ đặt ở server, KHÔNG đưa vào
# web/mobile. GEMINI_API_KEY ở đầu file dùng chung với OCR.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Chỉ máy dev: Ollama local, base kiểu OpenAI phải có /v1 (thiếu http:// thì nhà bị bỏ, có WARNING).
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Service nghiệp vụ trợ lý gọi thay người dùng (bằng token của chính họ). USER_SERVICE_URL ở trên
# dùng chung. Trong docker compose đổi thành tên service: http://loan:8081, http://payment:8082,
# http://investment:8084, http://user:8085, http://notification:8086.
LOAN_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_URL=http://localhost:8082
INVESTMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8086

# Hạn mức và thời gian chờ. Giá trị dưới là mặc định trong code; chỉ bỏ dấu # khi cần đổi.
# ASSISTANT_USER_RATE_PER_MINUTE=10
# ASSISTANT_USER_RATE_PER_DAY=100
# ASSISTANT_LLM_TIMEOUT_SECONDS=20
# ASSISTANT_TOOL_TIMEOUT_SECONDS=8
# ASSISTANT_SLOW_TOOL_TIMEOUT_SECONDS=30
# ASSISTANT_TURN_TIMEOUT_SECONDS=40
# ASSISTANT_MAX_CONCURRENT_LLM=2
