# =====================================================================
# finora-ai — biến môi trường chạy local
#
# Cách dùng: copy thành finora-ai/.env rồi điền giá trị (.env bị Git ignore).
# main.py tự nạp file này lúc khởi động; biến đã có sẵn trong môi trường
# thì giữ nguyên, không bị ghi đè.
# =====================================================================

# <<< PHẢI ĐIỀN >>> Lấy tại https://aistudio.google.com/apikey
# OCR CCCD chạy hoàn toàn bằng Gemini — thiếu key thì endpoint eKYC trả lỗi.
# LƯU Ý: ảnh CCCD (PII) sẽ được gửi tới API của Google.
GEMINI_API_KEY=

# Model đọc ảnh, mặc định gemini-2.5-flash
# GEMINI_OCR_MODEL=gemini-2.5-flash

# ── CIC Service (bản Node đã deploy Vercel) ──────────────────────────────────
# Chạy cic-service local thì đổi thành http://localhost:9000. Gọi lỗi hoặc quá
# CIC_TIMEOUT_SECONDS (mặc định 3 giây) thì hồ sơ bị chấm như chưa có dữ liệu CIC.
CIC_SERVICE_URL=https://cic-service-node.vercel.app
# CIC_TIMEOUT_SECONDS=3.0

# ── Tra CCCD qua finora-user để chấm điểm CIC ────────────────────────────────
# Loan Service không được giữ CCCD (xem BorrowerProfileResult), nên khi hồ sơ chỉ
# có borrower_id thì AI tự hỏi finora-user. Thiếu KEYCLOAK_CLIENT_SECRET thì bước
# này bị bỏ qua và hồ sơ bị chấm như người chưa có lịch sử tín dụng.
USER_SERVICE_URL=http://localhost:8085
KEYCLOAK_TOKEN_URL=http://localhost:8180/realms/finora/protocol/openid-connect/token
# Client riêng của AI (D34), chỉ có user:admin:read_all. docker/keycloak/add-service-clients.sh tạo client và ghi
# secret vào docker/.env (KEYCLOAK_AI_CLIENT_SECRET); chạy AI ngoài Docker thì chép giá trị đó vào đây.
KEYCLOAK_CLIENT_ID=finora-ai-client
KEYCLOAK_CLIENT_SECRET=<<< PHẢI ĐIỀN — trùng KEYCLOAK_AI_CLIENT_SECRET trong docker/.env >>>

# ── Xác thực request tới AI (D35) ────────────────────────────────────────────
# Mọi endpoint trừ /health cần access token Keycloak. Issuer cố định localhost:8180 (KC_HOSTNAME_URL); trong Docker
# JWKS đọc qua http://keycloak:8080/realms/finora/protocol/openid-connect/certs.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/finora
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/finora/protocol/openid-connect/certs
# local/e2e/demo mở Swagger (/docs); staging/production tắt.
FINORA_ENVIRONMENT=local
