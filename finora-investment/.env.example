# =====================================================================
# finora-investment — biến môi trường chạy local (Gọi vốn + Notes, task #10)
#
# Cách dùng:
#   1. Copy file này thành finora-investment/.env  (file .env bị Git ignore)
#   2. Điền giá trị được đánh dấu <<< PHẢI ĐIỀN >>>
#   3. Tạo DB:  psql -h localhost -U postgres -c "CREATE DATABASE finora_investment;"
#   4. Chạy:    mvn -pl finora-investment spring-boot:run
#      hoặc chạy FinoraInvestmentApplication trong IntelliJ
#      (working directory BẮT BUỘC = finora-investment/, nếu không sẽ không thấy file .env)
#
# application.yml nạp file này qua `spring.config.import: optional:file:.env[.properties]`
# nên định dạng là .properties: KEY=value, KHÔNG bọc nháy, KHÔNG có khoảng trắng quanh dấu =.
# Dòng bắt đầu bằng # hoặc ! là comment.
#
# Tính năng gọi vốn chạy độc lập: KHÔNG cần gateway, loan, payment, user, Kafka hay Docker.
# Chỉ cần PostgreSQL đang chạy trên máy.
# =====================================================================

# ── PostgreSQL (chạy trực tiếp trên máy, KHÔNG chạy trong Docker) ─────
# DB finora_investment phải tồn tại sẵn; Flyway tự chạy migration V1 khi app khởi động.
# LƯU Ý: mặc định trong application.yml trỏ tới container cổng 15437, nhưng docker/.env
# đang thiếu INVESTMENT_POSTGRES_HOST_PORT và để trống INVESTMENT_DB_PASSWORD.
# Ba dòng dưới ghi đè về Postgres local — đây là đường đã kiểm chứng chạy được.
INVESTMENT_DB_URL=jdbc:postgresql://localhost:5432/finora_investment
INVESTMENT_DB_USERNAME=postgres
# <<< PHẢI ĐIỀN >>> Mật khẩu user `postgres` của PostgreSQL trên máy bạn.
# Giống giá trị USER_DB_PASSWORD trong finora-user/.env.
INVESTMENT_DB_PASSWORD=

# ── Nguồn tiền khi đặt lệnh ──────────────────────────────────────────
# stub: ví giả lập trong bộ nhớ, dùng khi finora-payment (phần của Thái) chưa có API giữ tiền.
# rest: gọi Payment thật. Đổi mỗi giá trị này là đủ, KHÔNG phải sửa code nghiệp vụ.
INVESTMENT_PAYMENT_MODE=stub
# Chỉ có tác dụng khi INVESTMENT_PAYMENT_MODE=rest.
PAYMENT_SERVICE_URL=http://localhost:8082

# ── Kafka (tùy chọn) ─────────────────────────────────────────────────
# Outbox lấy KafkaTemplate qua ObjectProvider nên Kafka KHÔNG chạy cũng không lỗi:
# sự kiện nằm lại bảng outbox chờ gửi. Docker compose hiện chưa có service Kafka.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
