# =====================================================================
# finora-notification — biến môi trường chạy local
#
# Cách dùng:
#   1. Copy file này thành finora-notification/.env  (file .env bị Git ignore)
#   2. Chọn MỘT trong hai chế độ SMTP bên dưới
#   3. Chạy FinoraNotificationApplication (port 8086), working directory = finora-notification/
#
# Định dạng .properties: KEY=value, KHÔNG bọc nháy, KHÔNG có khoảng trắng quanh dấu =.
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# CHẾ ĐỘ A — Mailpit: mail server chạy local, KHÔNG gửi ra Internet.
# Dùng để test luồng OTP mà không cần tài khoản Gmail. Không cần password.
#
#   docker compose --env-file docker/.env -f docker/docker-compose.yml --profile mail up -d mailpit
#   Đọc thư tại: http://localhost:8025
#
# Bỏ dấu # ở 5 dòng dưới và comment lại toàn bộ CHẾ ĐỘ B.
# ─────────────────────────────────────────────────────────────────────
#MAIL_HOST=localhost
#MAIL_PORT=1025
#MAIL_SMTP_AUTH=false
#MAIL_SMTP_STARTTLS=false
#MAIL_USERNAME=finora.noreply@finora.local
#MAIL_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# CHẾ ĐỘ B — Gmail SMTP: gửi email thật vào hộp thư thật.
#
# Lấy App Password (bắt buộc, Gmail chặn đăng nhập bằng mật khẩu thường):
#   1. Bật xác minh 2 bước:  https://myaccount.google.com/signinoptions/twosv
#   2. Tạo App Password:     https://myaccount.google.com/apppasswords
#   3. Google trả về 16 ký tự dạng "abcd efgh ijkl mnop"
#      -> XOÁ HẾT KHOẢNG TRẮNG khi dán vào MAIL_PASSWORD
#
# Không có mục App Password nghĩa là tài khoản chưa bật xác minh 2 bước,
# hoặc là tài khoản Google Workspace bị admin chặn.
# ─────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Địa chỉ Gmail dùng để gửi — cũng là địa chỉ hiển thị ở mục From của email.
MAIL_USERNAME=

# <<< PHẢI ĐIỀN >>> App Password 16 ký tự, đã xoá khoảng trắng.
# ĐÂY LÀ SECRET: không commit finora-notification/.env, không dán vào chat/issue.
MAIL_PASSWORD=
