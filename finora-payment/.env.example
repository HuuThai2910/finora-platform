PAYMENT_DB_URL=jdbc:postgresql://localhost:15434/finora_payment
PAYMENT_DB_USERNAME=finora_payment
PAYMENT_DB_PASSWORD=

KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/finora
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/finora/protocol/openid-connect/certs
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Mock cho demo local. Đổi riêng nạp tiền sang zalopay sau khi có sandbox credential.
PAYMENT_DISBURSEMENT_PROVIDER=mock
PAYMENT_TOPUP_PROVIDER=mock
PAYMENT_SCHEDULING_ENABLED=true
PAYMENT_MOCK_OUTCOME=success

ZALOPAY_BASE_URL=https://sb-openapi.zalopay.vn
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=
ZALOPAY_REDIRECT_URL=

# Khoá ký pin-token xác nhận mã PIN (HS256, tối thiểu 32 byte). PHẢI giống nhau ở
# finora-user, finora-payment, finora-investment, finora-loan. Để comment thì dùng
# khoá dev mặc định trong application.yml; đặt rỗng sẽ làm mọi thao tác cần PIN bị từ chối.
# FINORA_PIN_TOKEN_SECRET=
