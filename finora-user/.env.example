# =====================================================================
# finora-user — biến môi trường chạy local
#
# Cách dùng:
#   1. Copy file này thành finora-user/.env  (file .env bị Git ignore)
#   2. Điền các giá trị được đánh dấu <<< PHẢI ĐIỀN >>>
#   3. Bật hạ tầng:  docker compose --env-file docker/.env -f docker/docker-compose.yml --profile core --profile user up -d
#   4. Chạy FinoraUserApplication trong IntelliJ (working directory = finora-user/)
#
# application.yml nạp file này qua `spring.config.import: optional:file:.env[.properties]`
# nên định dạng là .properties: KEY=value, KHÔNG bọc nháy, KHÔNG có khoảng trắng quanh dấu =.
# Dòng bắt đầu bằng # hoặc ! là comment.
# =====================================================================

# ── PostgreSQL (chạy trực tiếp trên máy, KHÔNG chạy trong Docker) ─────
# DB finora_user phải tồn tại sẵn; Flyway tự chạy migration khi app khởi động.
#   Tạo DB:  psql -h localhost -U postgres -c "CREATE DATABASE finora_user;"
USER_DB_URL=jdbc:postgresql://localhost:5432/finora_user
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=admin

# ── Redis (container finora-user-redis, profile `user`) ──────────────
# Lưu OTP quên mật khẩu (TTL 5 phút) và bộ đếm rate limit đăng nhập.
USER_REDIS_HOST=localhost
USER_REDIS_PORT=6381
# Để trống nếu USER_REDIS_PASSWORD trong docker/.env cũng để trống.
USER_REDIS_PASSWORD=

# ── Keycloak (container finora-keycloak, profile `core`) ─────────────
# Realm `finora`, 3 realm role ROLE_BORROWER / ROLE_INVESTOR / ROLE_ADMIN và client
# `finora-user-client` được tạo tự động từ docker/keycloak/template/realm-finora.json.
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=finora
KEYCLOAK_CLIENT_ID=finora-user-client

# <<< PHẢI ĐIỀN >>> Lấy đúng giá trị KEYCLOAK_CLIENT_SECRET trong docker/.env.
# Hai file BẮT BUỘC giống nhau: docker/.env nạp secret vào realm, file này để app xác thực.
KEYCLOAK_CLIENT_SECRET=

# Dùng để validate JWT ở tầng resource server. Giữ nguyên nếu không đổi port Keycloak.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/finora
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/finora/protocol/openid-connect/certs

# ── finora-notification (chạy ở IntelliJ, port 8086) ─────────────────
# Gửi welcome email, OTP quên mật khẩu và cảnh báo đăng nhập bất thường.
# Gọi best-effort: notification chết thì đăng ký/quên mật khẩu VẪN thành công,
# chỉ là không có email gửi đi (OTP vẫn nằm trong Redis key `reset_otp:<userId>`).
NOTIFICATION_SERVICE_URL=http://localhost:8086

# ── Mã hóa PII (CCCD, số điện thoại) ─────────────────────────────────
# <<< PHẢI ĐIỀN >>> Tự sinh chuỗi ngẫu nhiên, KHÔNG dùng lại giá trị của môi trường khác.
#   Sinh nhanh:  python -c "import secrets; print(secrets.token_urlsafe(36))"
# HMAC-SHA256: hash id_number/phone để tra cứu và check trùng. Đổi giá trị này
# sẽ làm mọi hash cũ trong DB không tra cứu được nữa.
FINORA_HMAC_SECRET=
# AES-256-GCM: mã hóa id_number/phone để giải mã lại khi hiển thị cho chủ hồ sơ.
# Độ dài tùy ý (key được derive bằng SHA-256), nhưng đổi thì không giải mã được dữ liệu cũ.
FINORA_AES_SECRET=

# ── Cookie access_token (web client) ─────────────────────────────────
# Local dùng http nên secure=false; production PHẢI đổi domain thật + secure=true.
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
