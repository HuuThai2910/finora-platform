FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# SHAP 0.44.1 chưa có wheel Python 3.12 nên chỉ stage build mới mang compiler.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Model khuôn mặt eKYC (YuNet + SFace của OpenCV Zoo) không nằm trong repo: tải lúc build
# bằng script chỉ dùng thư viện chuẩn Python (không cần curl), URL ghim theo commit và
# kiểm SHA-256 — sai hash thì build dừng. Đặt trước bước cài thư viện để đổi
# requirements không phải tải lại ~38 MB model.
COPY finora-ai/scripts/download_face_models.py ./scripts/download_face_models.py
RUN python scripts/download_face_models.py --dest /models/face

COPY finora-ai/requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip wheel --wheel-dir /wheels --requirement requirements.txt

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Image runtime chỉ giữ OpenMP cho XGBoost và Tesseract (kèm dữ liệu tiếng Anh) để đọc
# MRZ/số in trên CCCD; compiler không đi vào container cuối.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /wheels /wheels
COPY finora-ai/requirements.txt ./requirements.txt
RUN python -m pip install --no-index --find-links=/wheels --requirement requirements.txt \
    && rm -rf /wheels

COPY finora-ai/main.py ./main.py
COPY finora-ai/app ./app
# Image chỉ mang gói model runtime hiện hành và cấu hình policy; CSV huấn luyện không đi vào image.
COPY finora-ai/models/credit/model_v17.0.0.pkl ./models/credit/model_v17.0.0.pkl
COPY finora-ai/models/credit/model_v17.0.0.json ./models/credit/model_v17.0.0.json
COPY finora-ai/models/fraud/model_v1.1.0.pkl ./models/fraud/model_v1.1.0.pkl
COPY finora-ai/models/fraud/model_v1.1.0.json ./models/fraud/model_v1.1.0.json
COPY --from=builder /models/face ./models/face
COPY finora-ai/config/product_config.json ./config/product_config.json

RUN useradd --create-home --uid 10001 finora \
    && chown -R finora:finora /app
USER finora

EXPOSE 8000

# Không dùng --reload trong container tích hợp vì model chỉ được nạp một lần và image phải bất biến.
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
