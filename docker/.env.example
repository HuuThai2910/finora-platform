# Sao chép file này thành docker/.env rồi tự điền toàn bộ secret local.
# Không commit docker/.env và không tái sử dụng credential production.

# Core: Keycloak có MySQL riêng; database này không publish port ra host.
KEYCLOAK_DB_ROOT_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HOST_PORT=8180
KAFKA_HOST_PORT=9092

# Loan: MySQL instance riêng.
LOAN_MYSQL_ROOT_PASSWORD=
LOAN_MYSQL_HOST_PORT=13306
LOAN_DB_NAME=finora_loan
LOAN_DB_USERNAME=finora_loan
LOAN_DB_PASSWORD=
LOAN_HOST_PORT=8081
LOAN_ACTIVE_PROFILE=local-admin

# Payment: MySQL và Redis riêng.
PAYMENT_MYSQL_ROOT_PASSWORD=
PAYMENT_MYSQL_HOST_PORT=13307
PAYMENT_DB_NAME=finora_payment
PAYMENT_DB_USERNAME=finora_payment
PAYMENT_DB_PASSWORD=
PAYMENT_REDIS_HOST_PORT=6380
PAYMENT_REDIS_PASSWORD=

# User: MySQL instance riêng.
USER_MYSQL_ROOT_PASSWORD=
USER_MYSQL_HOST_PORT=13308
USER_DB_NAME=finora_user
USER_DB_USERNAME=finora_user
USER_DB_PASSWORD=

# Investment: MongoDB instance riêng.
INVESTMENT_MONGO_ROOT_USERNAME=
INVESTMENT_MONGO_ROOT_PASSWORD=
INVESTMENT_MONGO_HOST_PORT=27018
INVESTMENT_DB_NAME=finora_investment
INVESTMENT_DB_USERNAME=finora_investment
INVESTMENT_DB_PASSWORD=
