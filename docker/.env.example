# Sao chép file này thành docker/.env rồi tự điền toàn bộ secret local.
# Không commit docker/.env và không tái sử dụng credential production.

# Core — Keycloak (profile `core`).
# Kafka local cho transactional outbox Loan ↔ Investment.
KAFKA_HOST_PORT=9092

# Keycloak KHÔNG còn container PostgreSQL riêng: nó dùng PostgreSQL cài trên máy host.
# Tạo sẵn database trước khi chạy:
#   psql -h localhost -U postgres -c "CREATE DATABASE keycloak;"
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HOST_PORT=8180
# Issuer chuẩn được ghi vào JWT. Khi đổi host/port public phải cập nhật đồng thời.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# JDBC URL đầy đủ. Neon phải có `?sslmode=require`.
KEYCLOAK_DB_URL=jdbc:postgresql://host.docker.internal:5432/keycloak
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=

# Secret của confidential client `finora-user-client` trong realm `finora`.
# Service `keycloak-realm-init` ghi giá trị này vào realm import lúc khởi động.
# BẮT BUỘC trùng với KEYCLOAK_CLIENT_SECRET trong finora-user/.env.
#   Sinh nhanh:  python -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_CLIENT_SECRET=

# Secret của service account `finora-investment-client` (Auto-Invest giữ tiền thay nhà
# đầu tư qua Payment). BẮT BUỘC trùng với KEYCLOAK_INVESTMENT_CLIENT_SECRET trong
# finora-investment/.env. Realm đã tồn tại thì import bỏ qua client mới — chạy
# `bash docker/keycloak/add-investment-client.sh` để tạo trên realm đang chạy.
KEYCLOAK_INVESTMENT_CLIENT_SECRET=

# Service account của Loan (chấm điểm qua AI) và AI (đọc hồ sơ User) — W3A, D34.
# `bash docker/keycloak/add-service-clients.sh` tạo client trên realm đang chạy, sinh secret
# nếu để trống và tự ghi vào file này, finora-loan/.env, finora-ai/.env. Không chép tay vào git.
KEYCLOAK_LOAN_CLIENT_SECRET=
KEYCLOAK_AI_CLIENT_SECRET=

# Loan: PostgreSQL offline fallback; Neon dùng LOAN_DB_URL trong môi trường chạy app.
LOAN_POSTGRES_ADMIN_PASSWORD=
LOAN_POSTGRES_HOST_PORT=15433
LOAN_DB_NAME=finora_loan
LOAN_DB_USERNAME=finora_loan
LOAN_DB_PASSWORD=
LOAN_HOST_PORT=8081

# Apache Fineract 1.15.0: hai database Neon riêng của core banking, không dùng chung Loan DB.
# Dùng direct endpoint cho process dài hạn; ví dụ <project-id>.c-3.ap-southeast-1.aws.neon.tech.
FINERACT_POSTGRES_ADMIN_PASSWORD=
FINERACT_POSTGRES_HOST_PORT=15432
FINERACT_DB_HOST=
FINERACT_DB_PORT=5432
FINERACT_TENANTS_DB_NAME=fineract_tenants
FINERACT_DEFAULT_DB_NAME=fineract_default
FINERACT_DB_SSLMODE=require
FINERACT_DB_USERNAME=
FINERACT_DB_PASSWORD=
# Chỉ dùng bởi docker/smoke-fineract.ps1 khi chủ động kiểm tra PostgreSQL fallback local.
FINERACT_LOCAL_DB_USERNAME=fineract
FINERACT_LOCAL_DB_PASSWORD=
FINERACT_DEFAULT_MASTER_PASSWORD=
FINERACT_HOST_PORT=18443
FINERACT_API_USERNAME=mifos
FINERACT_API_PASSWORD=password
FINERACT_PREVIEW_CLIENT_EXTERNAL_ID=FINORA-PREVIEW-CLIENT

# Payment: PostgreSQL offline fallback. Payment không dùng Redis (B23, W3E), không còn PAYMENT_REDIS_*.
PAYMENT_POSTGRES_ADMIN_PASSWORD=
PAYMENT_POSTGRES_HOST_PORT=15434
PAYMENT_DB_NAME=finora_payment
PAYMENT_DB_USERNAME=finora_payment
PAYMENT_DB_PASSWORD=
PAYMENT_KAFKA_LISTENER_ENABLED=true
PAYMENT_DISBURSEMENT_PROVIDER=mock
PAYMENT_TOPUP_PROVIDER=mock
PAYMENT_MOCK_OUTCOME=success
LOAN_DISBURSEMENT_REQUESTED_TOPIC=finora.loan.disbursement-requested
PAYMENT_DISBURSEMENT_COMPLETED_TOPIC=finora.payment.disbursement-completed
PAYMENT_DISBURSEMENT_FAILED_TOPIC=finora.payment.disbursement-failed
LOAN_DISBURSED_TOPIC=finora.loan.disbursed
LOAN_DELINQUENCY_CHANGED_TOPIC=finora.loan.delinquency-changed
LOAN_SETTLED_TOPIC=finora.loan.settled
LOAN_RESCHEDULED_TOPIC=finora.loan.rescheduled
LOAN_RESCHEDULE_CONSENT_REQUESTED_TOPIC=finora.loan.reschedule-consent-requested
INVESTMENT_RESCHEDULE_CONSENT_COMPLETED_TOPIC=finora.investment.reschedule-consent-completed
LOAN_RESCHEDULE_WORKER_ENABLED=false
FINERACT_RESCHEDULE_REASON_ID=
LOAN_SERVICING_SYNC_ENABLED=true
LOAN_SERVICING_SYNC_WORKER_DELAY=60000
PAYMENT_CORE_POSTING_STALE_AFTER=1m
INVESTMENT_NOTE_OWNERSHIP_CHANGED_TOPIC=finora.investment.note-ownership-changed
PAYMENT_REPAYMENT_DISTRIBUTED_TOPIC=finora.payment.repayment-distributed
PAYMENT_SERVICING_GROUP=payment-servicing
PAYMENT_REPAYMENT_WORKER_DELAY=3000
PAYMENT_RECONCILIATION_WORKER_DELAY=30000
# Biểu phí trả trước/tất toán (tỷ lệ, mức tối thiểu, cách chia 80/20) không còn cấu hình bằng biến môi trường: mỗi
# khoản vay tính theo biểu phí ghi trong hợp đồng của nó (G-POLICY-W2). Chỉ còn thời hạn hiệu lực báo giá.
PAYMENT_EARLY_SETTLEMENT_QUOTE_TTL=15m

# Tenant demo chuẩn dùng Office, Payment Type và Legal Form PERSON đều có ID 1.
# Giữ mock cho tới khi muốn chạy booking thật; đổi provider thành fineract để bật.
FINERACT_BOOKING_PROVIDER=mock
FINERACT_OFFICE_ID=1
FINERACT_DISBURSEMENT_PAYMENT_TYPE_ID=1
FINERACT_CLIENT_LEGAL_FORM_ID=1
# V4 (2026-10-17, D15): lãi theo dư nợ và số ngày thực tế. Chỉ áp cho sản phẩm tạo mới; sản phẩm cũ giữ version của mình.
FINERACT_PRODUCT_CONFIG_VERSION=FINORA-FINERACT-V4
# Payment type dùng khi ghi giao dịch trả nợ vào Fineract. Giá trị 1 đúng với
# tenant demo chuẩn; nếu seed tenant thay đổi phải lấy lại từ /paymenttypes.
FINERACT_REPAYMENT_PAYMENT_TYPE_ID=1

# ZaloPay sandbox: để trống cho tới khi merchant được duyệt; không commit secret thật.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=
ZALOPAY_REDIRECT_URL=

# Blockchain: Neon là persistence chính. PostgreSQL Docker chỉ là fallback offline.
BLOCKCHAIN_POSTGRES_ADMIN_PASSWORD=
BLOCKCHAIN_POSTGRES_HOST_PORT=15435
BLOCKCHAIN_DB_NAME=finora_blockchain
BLOCKCHAIN_DB_URL=
BLOCKCHAIN_DB_USERNAME=
BLOCKCHAIN_DB_PASSWORD=
# Bật hai cờ này khi chạy finora-blockchain để consume bốn mốc proof (hợp đồng, giải ngân, trả nợ, Note) và xử lý proof.
# Provider nhận `MOCK` (chỉ dùng demo) hoặc `HYPERLEDGER_FABRIC` (mạng docker/fabric-network, xem README ở đó).
# Profile `apps` (D86) chỉ đọc BLOCKCHAIN_PROOF_PROVIDER (listener/worker luôn bật): đặt HYPERLEDGER_FABRIC sau
# `fabric-network.ps1 -Action Up` rồi `docker compose ... up -d blockchain`.
BLOCKCHAIN_KAFKA_LISTENER_ENABLED=false
BLOCKCHAIN_PROOF_WORKER_ENABLED=false
BLOCKCHAIN_PROOF_PROVIDER=MOCK

# Hyperledger Fabric local (profile `fabric`, W3D): chỉ gateway peer0.org1 mở ra 127.0.0.1. Khóa/chứng thư do
# docker/fabric-network/fabric-network.ps1 sinh vào thư mục git-ignore; FABRIC_CERT_PATH/KEY_PATH/TLS_CERT_PATH của
# finora-blockchain lấy từ docker/fabric-network/build/client.json (chỉ là đường dẫn file).
FABRIC_PEER0_ORG1_HOST_PORT=7051

# User — chỉ còn Redis (profile `user`). PostgreSQL của finora-user chạy trên máy host,
# cấu hình bằng USER_DB_* trong finora-user/.env chứ không qua file này.
USER_REDIS_HOST_PORT=6381
# Để trống = Redis không đặt password (đủ cho local dev).
USER_REDIS_PASSWORD=

# Profile `demo`: chay finora-user trong Docker va ket noi PostgreSQL ngoai Compose.
# Vi du Neon: jdbc:postgresql://<host>:5432/<database>?sslmode=require
USER_HOST_PORT=8085
USER_DB_URL=
USER_DB_USERNAME=
USER_DB_PASSWORD=
# B70/D84: chi bat khi CIC dich luu mapping rieng tu (CIC Node chay local cho E2E) hoac khi chi co du lieu gia. Ban CIC
# Node deploy tren Vercel khong xac thuc API doc va luu du lieu o /tmp (mat khi instance khoi dong lai): khong gui CCCD
# that toi do.
USER_CIC_MAPPING_ENABLED=false
USER_CIC_MAPPING_WORKER_DELAY=5000
USER_CIC_MAPPING_BATCH_SIZE=20
USER_CIC_MAPPING_MAX_ATTEMPTS=20
USER_CIC_MAPPING_LEASE_DURATION=2m
USER_CIC_MAPPING_INITIAL_RETRY_DELAY=30s
USER_CIC_MAPPING_MAX_RETRY_DELAY=15m

# Profile `apps` (D85): mac dinh gia lap nhu stack E2E de test UI bang tai khoan khong eKYC
# (docker/e2e/new-test-accounts.ps1), ghi de .env cua module. VNPT_SMART_CA: ky SmartCA UAT (VNPT_SMARTCA_* trong
# finora-loan/.env); user: Loan doc eKYC that; true: bat lai eKYC nha dau tu hoac worker Auto-Invest. Doi xong chay
# `docker compose ... up -d loan investment` (restart khong doc bien moi).
APPS_SIGNATURE_PROVIDER=MOCK
APPS_BORROWER_PROFILE_PROVIDER=mock
APPS_INVESTMENT_REQUIRE_EKYC=false
APPS_INVESTMENT_AUTO_INVEST_ENABLED=false

KEYCLOAK_REALM=finora

# Hai secret nay ma hoa/HMAC PII. Doi gia tri se lam du lieu cu khong the
# giai ma/tra cuu; khong tai su dung credential production.
FINORA_HMAC_SECRET=
FINORA_AES_SECRET=
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

# AI va User goi CIC Node da deploy qua URL nay; Compose khong build CIC nua.
CIC_SERVICE_URL=https://cic-service-node.vercel.app
CIC_INTERNAL_API_KEY=
GEMINI_API_KEY=

# Investment: PostgreSQL offline fallback; Neon dùng INVESTMENT_DB_URL trong môi trường chạy app.
INVESTMENT_POSTGRES_ADMIN_PASSWORD=
INVESTMENT_POSTGRES_HOST_PORT=15437
INVESTMENT_DB_NAME=finora_investment
INVESTMENT_DB_USERNAME=finora_investment
INVESTMENT_DB_PASSWORD=

# Notification PostgreSQL offline (chỉ cần khi chạy --profile notification)
NOTIFICATION_POSTGRES_ADMIN_PASSWORD=
NOTIFICATION_POSTGRES_HOST_PORT=15438
NOTIFICATION_DB_NAME=finora_notification
NOTIFICATION_DB_USERNAME=finora_notification
NOTIFICATION_DB_PASSWORD=

# Ngày nghiệp vụ của Loan/Payment (nộp hồ sơ, booking/giải ngân, ngày trả nợ, báo giá). Phải trùng múi giờ tenant
# Fineract; để trống dùng mặc định Asia/Ho_Chi_Minh.
FINORA_BUSINESS_TIME_ZONE=Asia/Ho_Chi_Minh

# Nguồn eKYC/tuổi người vay của Loan khi nộp hồ sơ: `user` (mặc định) gọi finora-user bằng token của người vay;
# `mock` (VERIFIED, 30 tuổi, nhãn hồ sơ giả lập) chỉ dùng cho test và stack E2E.
FINORA_BORROWER_PROFILE_PROVIDER=user

# Khi chạy Loan và Investment trực tiếp từ IntelliJ, hai service cùng dùng broker
# Kafka publish ở localhost. Outbox publisher và consumer của Loan/Investment luôn bật trong code;
# không còn cờ bật/tắt riêng (các biến *_OUTBOX_*/*_KAFKA_CONSUMER_ENABLED cũ không được đọc).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Mailpit (profile `mail`, tùy chọn): mail server local để test email OTP/welcome
# mà không cần Gmail App Password. Không cần credential.
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# AI API chỉ publish ở loopback; model v17 (`PHIEN_BAN_MAC_DINH`) được đóng trong image runtime.
AI_HOST_PORT=8000

# ── eKYC (EKYC-002) ───────────────────────────────────────────────────
# finora-user gọi /api/v1/ai/ekyc/* bằng service account finora-user-client (client role ai:ekyc:ocr, D34/D35),
# dùng chung KEYCLOAK_CLIENT_SECRET ở trên; không còn token nội bộ riêng.

# Kho bằng chứng eKYC local = SeaweedFS (bật bằng --profile ekyc). S3 API ở 127.0.0.1:9100
# (không dùng 9000 vì trùng CIC). Khoá chỉ gồm chữ, số và . _ ~ + / = -; tự sinh, không commit.
#   SEAWEEDFS_ADMIN_*: tài khoản quản trị, chỉ seaweedfs-init dùng để tạo bucket.
#   EKYC_S3_*: tài khoản của finora-user, chỉ đọc/ghi/liệt kê/gắn tag trên bucket eKYC.
#              Phải trùng EKYC_S3_ACCESS_KEY/EKYC_S3_SECRET_KEY trong finora-user/.env.
SEAWEEDFS_S3_HOST_PORT=9100
SEAWEEDFS_ADMIN_ACCESS_KEY=
SEAWEEDFS_ADMIN_SECRET_KEY=
EKYC_S3_ACCESS_KEY=
EKYC_S3_SECRET_KEY=
EKYC_S3_BUCKET=finora-ekyc
EKYC_S3_REGION=us-east-1
EKYC_S3_ENV=dev
# Lượt có kết quả cuối giữ bằng chứng bao nhiêu ngày (worker finora-user + lifecycle bucket).
EKYC_EVIDENCE_RETENTION_DAYS=30
# Chỉ dùng cho finora-user chạy trong Docker (profile demo); chạy IntelliJ thì đặt ở finora-user/.env.
EKYC_EVIDENCE_ENABLED=false
