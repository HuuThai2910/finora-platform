{
  "realm": "finora",
  "displayName": "FINORA",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "ROLE_BORROWER",
        "description": "Nguoi vay - vai tro mac dinh khi dang ky",
        "composite": true,
        "composites": {
          "client": {
            "finora-user-client": [
              "user:profile:read",
              "user:profile:write",
              "user:cccd:scan"
            ]
          }
        }
      },
      {
        "name": "ROLE_INVESTOR",
        "description": "Nha dau tu",
        "composite": true,
        "composites": {
          "client": {
            "finora-user-client": [
              "user:profile:read",
              "user:profile:write",
              "user:cccd:scan"
            ]
          }
        }
      },
      {
        "name": "ROLE_ADMIN",
        "description": "Quan tri he thong FINORA",
        "composite": true,
        "composites": {
          "client": {
            "finora-user-client": [
              "user:profile:read",
              "user:admin:read_all",
              "user:admin:lock",
              "user:admin:assign_role"
            ]
          }
        }
      }
    ],
    "client": {
      "finora-investment-client": [
        {
          "name": "payment:hold:on_behalf",
          "description": "Auto-Invest: giu/nha tien trong vi thay nha dau tu (chi hold/release)"
        }
      ],
      "finora-loan-client": [
        {
          "name": "ai:credit:score",
          "description": "Worker cham diem cua Loan goi AI /credit/explain (D34)"
        }
      ],
      "finora-user-client": [
        {
          "name": "user:profile:read",
          "description": "Xem ho so ca nhan cua chinh minh"
        },
        {
          "name": "user:profile:write",
          "description": "Cap nhat ho so ca nhan cua chinh minh"
        },
        {
          "name": "user:cccd:scan",
          "description": "Nhap va xac minh thong tin CCCD"
        },
        {
          "name": "user:admin:read_all",
          "description": "Xem danh sach toan bo nguoi dung"
        },
        {
          "name": "user:admin:lock",
          "description": "Khoa hoac mo khoa tai khoan nguoi dung"
        },
        {
          "name": "user:admin:assign_role",
          "description": "Gan hoac doi vai tro nguoi dung"
        },
        {
          "name": "ai:ekyc:ocr",
          "description": "Service account finora-user goi AI OCR CCCD (D34); khong nam trong role nguoi dung"
        },
        {
          "name": "notification:internal:send",
          "description": "Service account finora-user goi endpoint noi bo gui email cua Notification (D36)"
        },
        {
          "name": "user:identity:read_internal",
          "description": "Service account finora-investment doc ho ten + CCCD da che de in giay chuyen nhuong Note; khong nam trong role nguoi dung"
        }
      ]
    }
  },

  "clients": [
    {
      "clientId": "finora-investment-client",
      "name": "FINORA Investment Service",
      "description": "Service account cua finora-investment: Auto-Invest goi Payment, giay chuyen nhuong Note doc danh tinh tu User khi khong co JWT nguoi dung",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__KEYCLOAK_INVESTMENT_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "roles"
      ]
    },
    {
      "clientId": "finora-loan-client",
      "name": "FINORA Loan Service",
      "description": "Service account cua finora-loan: worker cham diem goi AI khi khong co JWT nguoi dung (D34)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__KEYCLOAK_LOAN_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "roles"
      ]
    },
    {
      "clientId": "finora-ai-client",
      "name": "FINORA AI Service",
      "description": "Service account cua finora-ai: chi doc ho so User de lay CCCD just-in-time khi cham diem (D34)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__KEYCLOAK_AI_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "roles"
      ]
    },
    {
      "clientId": "finora-user-client",
      "name": "FINORA User Service",
      "description": "Confidential client cua finora-user: password grant cho dang nhap + service account cho Admin REST API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__KEYCLOAK_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false"
      },
      "protocolMappers": [
        {
          "name": "user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "user_id",
            "claim.name": "user_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "ekyc-status",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ekyc_status",
            "claim.name": "ekyc_status",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "acr",
        "email",
        "profile",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "address",
        "microprofile-jwt",
        "offline_access",
        "phone"
      ]
    }
  ],

  "users": [
    {
      "username": "service-account-finora-investment-client",
      "enabled": true,
      "serviceAccountClientId": "finora-investment-client",
      "clientRoles": {
        "finora-investment-client": [
          "payment:hold:on_behalf"
        ],
        "finora-user-client": [
          "user:identity:read_internal"
        ]
      }
    },
    {
      "username": "service-account-finora-user-client",
      "enabled": true,
      "serviceAccountClientId": "finora-user-client",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups",
          "view-realm"
        ],
        "finora-user-client": [
          "user:admin:read_all",
          "ai:ekyc:ocr",
          "notification:internal:send"
        ]
      }
    },
    {
      "username": "service-account-finora-loan-client",
      "enabled": true,
      "serviceAccountClientId": "finora-loan-client",
      "clientRoles": {
        "finora-loan-client": [
          "ai:credit:score"
        ]
      }
    },
    {
      "username": "service-account-finora-ai-client",
      "enabled": true,
      "serviceAccountClientId": "finora-ai-client",
      "clientRoles": {
        "finora-user-client": [
          "user:admin:read_all"
        ]
      }
    }
  ]
}
