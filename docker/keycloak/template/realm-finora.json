{
  "realm": "finora",
  "displayName": "FINORA",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "ROLE_BORROWER",
        "description": "Nguoi vay - vai tro mac dinh khi dang ky",
        "composite": true,
        "composites": {
          "client": {
            "finora-user-client": [
              "user:profile:read",
              "user:profile:write",
              "user:cccd:scan"
            ]
          }
        }
      },
      {
        "name": "ROLE_INVESTOR",
        "description": "Nha dau tu",
        "composite": true,
        "composites": {
          "client": {
            "finora-user-client": [
              "user:profile:read",
              "user:profile:write",
              "user:cccd:scan"
            ]
          }
        }
      },
      {
        "name": "ROLE_ADMIN",
        "description": "Quan tri he thong FINORA",
        "composite": true,
        "composites": {
          "client": {
            "finora-user-client": [
              "user:profile:read",
              "user:admin:read_all",
              "user:admin:lock",
              "user:admin:assign_role"
            ]
          }
        }
      }
    ],
    "client": {
      "finora-user-client": [
        {
          "name": "user:profile:read",
          "description": "Xem ho so ca nhan cua chinh minh"
        },
        {
          "name": "user:profile:write",
          "description": "Cap nhat ho so ca nhan cua chinh minh"
        },
        {
          "name": "user:cccd:scan",
          "description": "Nhap va xac minh thong tin CCCD"
        },
        {
          "name": "user:admin:read_all",
          "description": "Xem danh sach toan bo nguoi dung"
        },
        {
          "name": "user:admin:lock",
          "description": "Khoa hoac mo khoa tai khoan nguoi dung"
        },
        {
          "name": "user:admin:assign_role",
          "description": "Gan hoac doi vai tro nguoi dung"
        }
      ]
    }
  },

  "clients": [
    {
      "clientId": "finora-user-client",
      "name": "FINORA User Service",
      "description": "Confidential client cua finora-user: password grant cho dang nhap + service account cho Admin REST API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__KEYCLOAK_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": [
        "acr",
        "email",
        "profile",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "address",
        "microprofile-jwt",
        "offline_access",
        "phone"
      ]
    }
  ],

  "users": [
    {
      "username": "service-account-finora-user-client",
      "enabled": true,
      "serviceAccountClientId": "finora-user-client",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups",
          "view-realm"
        ]
      }
    }
  ]
}
