    {
      "username": "service-account-finora-user-client",
      "enabled": true,
      "serviceAccountClientId": "finora-user-client",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups",
          "view-realm",
          "manage-realm",
          "manage-clients"
        ],
        "finora-user-client": [
          "user:admin:read_all",
          "ai:ekyc:ocr",
          "notification:internal:send"
        ]
      }
    },
    {
      "username": "service-account-finora-loan-client",
      "enabled": true,
      "serviceAccountClientId": "finora-loan-client",
      "clientRoles": {
        "finora-loan-client": [
          "ai:credit:score"
        ]
      }
    },
    {
      "username": "service-account-finora-ai-client",
      "enabled": true,
      "serviceAccountClientId": "finora-ai-client",
      "clientRoles": {
        "finora-user-client": [
          "user:admin:read_all"
        ]
      }
    }
  ]
