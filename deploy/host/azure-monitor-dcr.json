{
  "location": "malaysiawest",
  "kind": "Linux",
  "properties": {
    "description": "Log container FINORA (Docker syslog driver, facility local0) vào Log Analytics finora-logs",
    "dataSources": {
      "syslog": [
        {
          "name": "finoraContainers",
          "streams": ["Microsoft-Syslog"],
          "facilityNames": ["local0"],
          "logLevels": ["Info", "Notice", "Warning", "Error", "Critical", "Alert", "Emergency"]
        }
      ]
    },
    "destinations": {
      "logAnalytics": [
        {
          "name": "finoraLogs",
          "workspaceResourceId": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/finora-rg/providers/Microsoft.OperationalInsights/workspaces/finora-logs"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": ["Microsoft-Syslog"],
        "destinations": ["finoraLogs"]
      }
    ]
  }
}
