# Database (D39): mặc định là PostgreSQL local của docker-compose (loan-postgres, cổng 15433).
# Dùng Neon hoặc DB khác thì bỏ comment và đặt cả ba biến; để trống URL/username sẽ ghi đè mặc định bằng chuỗi rỗng.
# Không commit host/tài khoản thật.
# LOAN_DB_URL=
# LOAN_DB_USERNAME=
LOAN_DB_PASSWORD=

# Local/dev default: click-wrap mock. Do not call this a digital signature.
FINORA_SIGNATURE_PROVIDER=MOCK

# VNPT SmartCA UAT only. Copy these names to your local .env and fill the values there.
# Never commit sp_password, user ID, serial number, OTP, access token or private key.
VNPT_SMARTCA_BASE_URL=https://rmgateway.vnptit.vn/sca/sp769
VNPT_SMARTCA_SP_ID=
VNPT_SMARTCA_SP_PASSWORD=
VNPT_SMARTCA_SANDBOX_FIXED_SIGNER_ENABLED=false
VNPT_SMARTCA_SANDBOX_USER_ID=
VNPT_SMARTCA_SANDBOX_SERIAL_NUMBER=
VNPT_SMARTCA_CONNECT_TIMEOUT=3s
VNPT_SMARTCA_READ_TIMEOUT=15s

# Loan ↔ Investment qua transactional outbox/Kafka là luồng bắt buộc trước khi tạo Contract.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Giai đoạn demo nên chạy `mock` để nghiệm thu toàn bộ Saga không cần tiền thật.
# Đổi thành `fineract` sau khi đã lấy đúng Office/Payment Type từ tenant local.
FINERACT_BOOKING_PROVIDER=mock
FINERACT_BASE_URL=http://localhost:18443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_API_USERNAME=
FINERACT_API_PASSWORD=
FINERACT_OFFICE_ID=
FINERACT_DISBURSEMENT_PAYMENT_TYPE_ID=
FINERACT_TRANSACTION_PROCESSING_STRATEGY_CODE=mifos-standard-strategy

# Danh tính Loan khi worker chấm điểm gọi AI (W3A, D34): client finora-loan-client, client role ai:credit:score.
# `bash docker/keycloak/add-service-clients.sh` tạo client và tự ghi secret vào .env; thiếu thì chấm điểm chờ retry.
KEYCLOAK_LOAN_CLIENT_SECRET=

# Khoá ký pin-token xác nhận mã PIN (HS256, tối thiểu 32 byte). PHẢI giống nhau ở
# finora-user, finora-payment, finora-investment, finora-loan. Để comment thì dùng
# khoá dev mặc định trong application.yml; đặt rỗng sẽ làm mọi thao tác cần PIN bị từ chối.
# FINORA_PIN_TOKEN_SECRET=
