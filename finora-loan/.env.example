# Local/dev default: click-wrap mock. Do not call this a digital signature.
FINORA_SIGNATURE_PROVIDER=MOCK

# VNPT SmartCA UAT only. Copy these names to your local .env and fill the values there.
# Never commit sp_password, user ID, serial number, OTP, access token or private key.
VNPT_SMARTCA_BASE_URL=https://rmgateway.vnptit.vn/sca/sp769
VNPT_SMARTCA_SP_ID=
VNPT_SMARTCA_SP_PASSWORD=
VNPT_SMARTCA_SANDBOX_FIXED_SIGNER_ENABLED=false
VNPT_SMARTCA_SANDBOX_USER_ID=
VNPT_SMARTCA_SANDBOX_SERIAL_NUMBER=
VNPT_SMARTCA_CONNECT_TIMEOUT=3s
VNPT_SMARTCA_READ_TIMEOUT=15s
